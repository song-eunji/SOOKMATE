# 시연용 설정 (비밀 값 없음)
# backend 폴더에서 이 파일을 .env 로 복사한 뒤 서버를 켜세요.
#   Windows : copy .env.demo .env
#   맥/리눅스: cp .env.demo .env

# 개발 모드: 가입할 때 인증 코드를 메일로 보내지 않고 화면에 바로 보여줍니다 (메일 설정 불필요)
DEV_MODE=1
# 가짜 상대가 추천을 자동으로 수락하고, 대화방에서 답장합니다
DEMO_PARTNERS=1
# 로그인 화면의 "개발자 입장": 가짜 프로필 중 하나를 골라 바로 들어갑니다
DEV_LOGIN=1

# 번역과 만나기 전 브리핑은 Gemini 키가 있어야 합니다. 키는 단체방에 올리지 말고 개인 채널로 받아 아래에 붙여 넣으세요.
# 비워 두어도 앱은 동작하고, 번역·브리핑만 기본 안내로 나옵니다.
GEMINI_API_KEY=
