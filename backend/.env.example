# 복사해서 .env 로 만든 뒤 사용: uvicorn app.main:app --reload --env-file .env
# .env 는 저장소에 올라가지 않습니다(.gitignore).

# 무료 티어 테스트용 Gemini. 키는 Google AI Studio에서 발급합니다.
# 무료 사용/호출 한도는 해당 프로젝트에서 확인하세요.
# auto: GEMINI_API_KEY가 있으면 Gemini, 없으면 Anthropic을 사용합니다.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 번역처럼 짧고 자주 부르는 일에 쓸 모델. 비워 두면 위의 GEMINI_MODEL 을 그대로 씁니다.
# GEMINI_FAST_MODEL=
# 요청별 응답 대기 시간. 일시적인 5xx 응답만 한 번 재시도합니다.
LLM_TIMEOUT_SECONDS=30

# 두 공급자 모두 키가 없으면 기본(fallback) 방식으로 나옵니다.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 기본은 SQLite 파일. PostgreSQL 예: postgresql+psycopg://user:password@localhost:5432/sookmate
# DATABASE_URL=sqlite:///./sookmate.db

# 0 으로 두면 개발용 사용자 전환과 /api/dev/* 를 끕니다.
DEV_MODE=1
# 로그인이 없는 동안 X-User-Id 헤더가 없을 때 쓸 사용자
DEFAULT_USER_ID=1
# 임베딩 방식: ngram(기본) 또는 st(다국어 모델, sentence-transformers 설치 필요)
# EMBED_BACKEND=st

# Google 검색도 GEMINI_API_KEY를 사용합니다. 별도 검색 서비스 키는 필요하지 않습니다.
# 기본은 GEMINI_MODEL과 동일한 모델. 검색 지원/무료 한도는 프로젝트에서 확인하세요.
# GEMINI_SEARCH_MODEL=gemini-2.5-flash

# 학교 메일 인증 로그인 -------------------------------------------------
# 로그인을 허용할 메일 도메인 (여러 개면 쉼표로). 하위 도메인은 받지 않습니다.
# ALLOWED_EMAIL_DOMAINS=sookmyung.ac.kr
# 인증 코드를 메일로 보내려면 SMTP 정보를 채우세요. 비밀번호는 이 파일(.env)에만 두고 저장소에는 올리지 않습니다.
# 비워 두면: DEV_MODE=1 이면 서버 로그와 화면에 코드가 보이고, DEV_MODE=0 이면 로그인이 안 됩니다(메일 발송 설정 필요).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
