# 복사해서 .env 로 만든 뒤 사용: uvicorn app.main:app --reload --env-file .env
# .env 는 저장소에 올라가지 않습니다(.gitignore).

# 비워 두면 브리핑·활동 카드가 기본(fallback) 방식으로 나옵니다.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 기본은 SQLite 파일. PostgreSQL 예: postgresql+psycopg://user:password@localhost:5432/sookmate
# DATABASE_URL=sqlite:///./sookmate.db

# 0 으로 두면 개발용 사용자 전환과 /api/dev/* 를 끕니다.
DEV_MODE=1
# 로그인이 없는 동안 X-User-Id 헤더가 없을 때 쓸 사용자
DEFAULT_USER_ID=1
